# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit it.
# On RunPod, set these via the pod's Environment Variables UI instead.

# HuggingFace token — required to download gated models (Llama 3.2 1B, Llama 3.1 8B).
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Model to load. Defaults to Llama 3.2 1B for local dev.
# Override to meta-llama/Meta-Llama-3.1-8B-Instruct on RunPod.
MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct

# Thread pool size. 4 is the default.
MAX_WORKERS=4

# Set to true to skip model loading and simulate inference with a sleep.
# Useful for testing the benchmark pipeline without a GPU or large model.
MOCK_MODE=false
MOCK_LATENCY=2.0
